# TCP port on which the HTTP service listens.
PORT=3000
# Directory reserved for PGlite data in a later task.
PGLITE_DATA_DIR=./data
# Encryption key reserved for database secrets in a later task.
DB_ENCRYPTION_KEY=replace-with-encryption-key
# Whether session cookies should use the Secure attribute in a later task.
COOKIE_SECURE=false
# Microsoft Entra tenant identifier reserved for OIDC configuration in a later task.
TENANT_ID=00000000-0000-0000-0000-000000000000
# Microsoft Entra application client identifier reserved for OIDC configuration in a later task.
CLIENT_ID=00000000-0000-0000-0000-000000000000
# Canonical session-token issuer; the production value must be https://orca.biztechro.com.
SERVICE_ISSUER=https://orca.biztechro.com
